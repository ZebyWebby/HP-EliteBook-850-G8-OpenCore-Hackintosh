+/* Check if the first set of coordinates is within limit of the second set on both axes
+ */
+static bool isWithin(IOFixed x, IOFixed y, IOFixed other_x, IOFixed other_y, IOFixed limit) {
+    IOFixed diff_x = x - other_x;
+    IOFixed diff_y = y - other_y;
+    return diff_x <= limit && diff_x >= -limit && diff_y <= limit && diff_y >= -limit;
+}
