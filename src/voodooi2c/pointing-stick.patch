+MultitouchReturn VoodooI2CNativeEngine::handleTrackpointReport(SInt32 dx, SInt32 dy, UInt32 buttons, AbsoluteTime timestamp) {
+    if (!voodooInputInstance)
+        return MultitouchReturnContinue;
+
+    // VoodooInput's TrackpointDevice applies the deadzone, speed multipliers and middle button scrolling
+    TrackpointReport report;
+    report.timestamp = timestamp;
+    report.dx = dx;
+    report.dy = dy;
+    report.buttons = buttons;
+
+    super::messageClient(kIOMessageVoodooTrackpointMessage, voodooInputInstance, &report, sizeof(report));
+    return MultitouchReturnBreak;
+}
