+void VoodooI2CMultitouchHIDEventDriver::parseRelativePointerElements(OSArray* top_level) {
+    relative_pointer_count = 0;
+
+    OSArray* elements = OSArray::withCapacity(64);
+    if (!elements)
+        return;
+
+    collectElements(top_level, elements);
+
+    for (int index = 0, count = elements->getCount(); index < count; index++) {
+        IOHIDElement* element = OSDynamicCast(IOHIDElement, elements->getObject(index));
+        if (!element)
+            continue;
+
+        IOHIDElementType type = element->getType();
+        if (type != kIOHIDElementTypeInput_Misc && type != kIOHIDElementTypeInput_Button && type != kIOHIDElementTypeInput_Axis)
+            continue;
+
+        UInt32 usage_page = element->getUsagePage();
+        UInt32 usage = element->getUsage();
+        bool is_axis = usage_page == kHIDPage_GenericDesktop && (usage == kHIDUsage_GD_X || usage == kHIDUsage_GD_Y);
+        bool is_button = usage_page == kHIDPage_Button && usage >= kHIDUsage_Button_1 && usage <= kMaxRelativePointerButtons;
+
+        if (!is_axis && !is_button)
+            continue;
+
+        // Absolute X/Y belongs to digitiser or absolute mouse collections, leave those alone
+        if (is_axis && !(element->getFlags() & kIOHIDElementFlagsRelativeMask))
+            continue;
+
+        // Only take elements that live inside a generic desktop mouse collection
+        bool in_mouse = false;
+        for (IOHIDElement* parent = element->getParentElement(); parent; parent = parent->getParentElement()) {
+            if (parent->getType() == kIOHIDElementTypeCollection && parent->conformsTo(kHIDPage_GenericDesktop, kHIDUsage_GD_Mouse)) {
+                in_mouse = true;
+                break;
+            }
+        }
+
+        if (!in_mouse)
+            continue;
+
+        UInt32 report_id = element->getReportID();
+        RelativePointer* pointer = nullptr;
+
+        for (int i = 0; i < relative_pointer_count; i++) {
+            if (relative_pointers[i].report_id == report_id) {
+                pointer = &relative_pointers[i];
+                break;
+            }
+        }
+
+        if (!pointer) {
+            if (relative_pointer_count >= kMaxRelativePointers)
+                continue;
+
+            pointer = &relative_pointers[relative_pointer_count++];
+            *pointer = RelativePointer();
+            pointer->report_id = report_id;
+        }
+
+        if (is_axis) {
+            if (usage == kHIDUsage_GD_X && !pointer->x)
+                pointer->x = element;
+            else if (usage == kHIDUsage_GD_Y && !pointer->y)
+                pointer->y = element;
+        } else if (!pointer->buttons[usage - kHIDUsage_Button_1]) {
+            pointer->buttons[usage - kHIDUsage_Button_1] = element;
+        }
+    }
+
+    // Drop collections without both axes
+    UInt8 kept = 0;
+    for (int i = 0; i < relative_pointer_count; i++) {
+        if (!relative_pointers[i].x || !relative_pointers[i].y)
+            continue;
+
+        relative_pointers[kept++] = relative_pointers[i];
+        IOLog("%s::%s Relative pointer found on report 0x%02x, forwarding it to the trackpoint device\n", getName(), name, relative_pointers[i].report_id);
+    }
+    relative_pointer_count = kept;
+
+    // the pointers keep their element references, the elements are retained by the hid device
+    elements->release();
+}
