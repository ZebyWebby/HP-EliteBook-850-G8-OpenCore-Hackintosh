+bool VoodooI2CMultitouchHIDEventDriver::handleRelativePointerReport(AbsoluteTime timestamp, UInt32 report_id) {
+    RelativePointer* pointer = nullptr;
+
+    for (int i = 0; i < relative_pointer_count; i++) {
+        if (relative_pointers[i].report_id == report_id) {
+            pointer = &relative_pointers[i];
+            break;
+        }
+    }
+
+    if (!pointer)
+        return false;
+
+    SInt32 delta[2] = {0, 0};
+    IOHIDElement* axes[2] = {pointer->x, pointer->y};
+
+    for (int i = 0; i < 2; i++) {
+        UInt32 value = axes[i]->getValue();
+        UInt32 size = axes[i]->getReportSize();
+
+        // Sign extend from the field size, logical min is negative for relative axes
+        if (size > 0 && size < 32 && (SInt32)axes[i]->getLogicalMin() < 0) {
+            UInt32 shift = 32 - size;
+            delta[i] = ((SInt32)(value << shift)) >> shift;
+        } else {
+            delta[i] = (SInt32)value;
+        }
+    }
+
+    UInt32 buttons = 0;
+
+    for (int i = 0; i < kMaxRelativePointerButtons; i++) {
+        if (pointer->buttons[i] && pointer->buttons[i]->getValue())
+            buttons |= 1 << i;
+    }
+
+    if (multitouch_interface)
+        multitouch_interface->handleTrackpointReport(delta[0], delta[1], buttons, timestamp);
+
+    return true;
+}
+
+// kIOHIDElementKey only holds the top level collections, the fields live in their children
+static void collectElements(OSArray* elements, OSArray* out) {
+    for (int index = 0, count = elements->getCount(); index < count; index++) {
+        IOHIDElement* element = OSDynamicCast(IOHIDElement, elements->getObject(index));
+        if (!element)
+            continue;
+
+        out->setObject(element);
+
+        OSArray* children = element->getChildElements();
+        if (children)
+            collectElements(children, out);
+    }
+}
